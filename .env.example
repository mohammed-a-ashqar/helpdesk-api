# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Set to true when running behind a reverse proxy / load balancer
TRUST_PROXY=false
# Comma-separated list of allowed browser origins (empty = CORS disabled)
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgres://helpdesk:helpdesk@localhost:5432/helpdesk
