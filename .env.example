# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Set to true when running behind a reverse proxy / load balancer
TRUST_PROXY=false
# Comma-separated list of allowed browser origins (empty = CORS disabled)
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgres://helpdesk:helpdesk@localhost:5432/helpdesk

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2

# Tickets
# Assign new tickets to the least-loaded active agent of their category
AUTO_ASSIGN_ON_CREATE=true
